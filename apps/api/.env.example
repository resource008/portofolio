# Server
# contoh: 3001
PORT=
# development | production
NODE_ENV=

# Database (PostgreSQL) — docker-compose di infra/ memakai port 5433
# contoh: postgres://USER:PASSWORD@localhost:5433/portofolio
DATABASE_URL=

# Better Auth
# Wajib string acak minimal 32 karakter di production: openssl rand -base64 32
BETTER_AUTH_SECRET=
# contoh: http://localhost:3001
BETTER_AUTH_URL=

# GitHub OAuth (Better Auth provider)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Admin allowlist (username GitHub, pisahkan dengan koma). Kosong = tidak ada yang bisa login.
ADMIN_GITHUB_USERNAMES=

# CORS origin (React SPA), contoh: http://localhost:5173
WEB_ORIGIN=

# Isi true hanya jika API berada di belakang reverse proxy yang mengirim X-Forwarded-For
# (dipakai untuk rate limit dan IP analytics). Selain itu biarkan false/kosong.
TRUST_PROXY=

# Object storage (Vercel Blob) — buat store di dashboard Vercel, salin tokennya
BLOB_READ_WRITE_TOKEN=

# Batas penyimpanan blob (MB) untuk meter "Penyimpanan" di dashboard.
# Sesuaikan dengan limit plan Vercel Blob kamu, contoh: 10240 (= 10 GB).
STORAGE_LIMIT_MB=
